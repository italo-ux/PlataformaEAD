# Backend
JWT_SECRET=gere_uma_chave_longa_e_aleatoria
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=plataforma_ead
DB_SYNCHRONIZE=false
DB_SSL=false
# Opcional: certificado da autoridade certificadora para DB_SSL=true.
DB_SSL_CA=
DB_POOL_MAX=5
DB_MAINTENANCE_NAME=postgres

# Revalidação assíncrona de vídeos (exige conexão direta ou pooler de sessão)
YOUTUBE_VALIDATION_WORKER_ENABLED=true
YOUTUBE_VALIDATION_TTL_MINUTES=15

# Atalho controlado para cursos marcados como ambiente de teste
ALLOW_TEST_COURSE_BYPASS=false

# Certificados
CERTIFICATE_ISSUER_NAME="Plataforma EAD Inovação Barueri"
CERTIFICATE_VERIFY_BASE_URL=http://localhost:5173/certificados/validar

# SMTP (obrigatório em produção; opcional em desenvolvimento)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plataforma EAD <no-reply@example.com>"
INSTITUTION_EMAIL=

# Frontend (copie somente esta configuração para frontend/.env.local)
VITE_API_URL=http://localhost:3000
VITE_ENABLE_TEST_COURSES=false
